<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%231a1a1a'/><text x='16' y='22' font-family='Georgia,serif' font-size='15' font-weight='700' fill='%23fffdfa' text-anchor='middle'>M</text></svg>">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- comment -%} Self-hosted type. assets/ is flat in Shopify, so the @font-face
  block lives here and resolves each file through asset_url. {%- endcomment -%}
  {{ 'crimson-pro-700-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
  {{ 'barlow-500-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
  <style>
    {%- assign latin_ext = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF' -%}
    {%- assign latin = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD' -%}
    {%- assign barlow_weights = '400,500,600,700' | split: ',' -%}
    {%- for w in barlow_weights -%}
      @font-face{font-family:'Barlow';font-style:normal;font-weight:{{ w }};font-display:swap;src:url({{ 'barlow-' | append: w | append: '-latin-ext.woff2' | asset_url }}) format('woff2');unicode-range:{{ latin_ext }};}
      @font-face{font-family:'Barlow';font-style:normal;font-weight:{{ w }};font-display:swap;src:url({{ 'barlow-' | append: w | append: '-latin.woff2' | asset_url }}) format('woff2');unicode-range:{{ latin }};}
    {%- endfor -%}
    {%- assign crimson_weights = '400,600,700' | split: ',' -%}
    {%- for w in crimson_weights -%}
      @font-face{font-family:'Crimson Pro';font-style:normal;font-weight:{{ w }};font-display:swap;src:url({{ 'crimson-pro-' | append: w | append: '-latin-ext.woff2' | asset_url }}) format('woff2');unicode-range:{{ latin_ext }};}
      @font-face{font-family:'Crimson Pro';font-style:normal;font-weight:{{ w }};font-display:swap;src:url({{ 'crimson-pro-' | append: w | append: '-latin.woff2' | asset_url }}) format('woff2');unicode-range:{{ latin }};}
    {%- endfor -%}
  </style>

  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">

  <script>document.documentElement.className = document.documentElement.className.replace('no-js', '');</script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">
  <a class="skip-link" href="#main">{{ 'general.accessibility.skip_to_content' | t }}</a>

  {% render 'icon-defs' %}

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <div class="overlay" data-overlay></div>
  {% render 'drawers' %}
  {% section 'cart-drawer' %}
</body>
</html>
