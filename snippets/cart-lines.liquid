{%- if cart.item_count == 0 -%}
  <div class="cart-empty">
    <p class="lede">{{ 'sections.cart.empty' | t }}</p>
    <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}" style="margin-top:var(--space-5)">
      {{ 'general.continue_shopping' | t }}
    </a>
  </div>
{%- else -%}
  {%- for line in cart.items -%}
    <div class="cart-line">
      <a class="cart-line__media" href="{{ line.url }}">
        <img src="{{ line.image | image_url: width: 200 }}" alt="{{ line.title | escape }}" loading="lazy" width="100" height="133">
      </a>
      <div>
        <p class="cart-line__title"><a href="{{ line.url }}">{{ line.product.title }}</a></p>
        {%- unless line.variant.title contains 'Default' -%}
          <p class="cart-line__variant">{{ line.variant.title }}</p>
        {%- endunless -%}
        <div class="cart-line__foot">
          <div class="qty">
            <button type="button" data-qty-change="{{ line.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'sections.cart.decrease' | t }}">&minus;</button>
            <output>{{ line.quantity }}</output>
            <button type="button" data-qty-change="{{ line.quantity | plus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'sections.cart.increase' | t }}">+</button>
          </div>
          <span class="product-card__price">{{ line.final_line_price | money }}</span>
        </div>
      </div>
    </div>
  {%- endfor -%}
{%- endif -%}
