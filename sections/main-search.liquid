<section class="page-head">
  <div class="container">
    <h1 class="page-head__title">{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form search-form--page">
      {% render 'icon', name: 'search' %}
      <label class="visually-hidden" for="page-search">{{ 'general.search.placeholder' | t }}</label>
      <input id="page-search" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    </form>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    {%- if search.performed -%}
      <p class="collection-count">{{ 'general.search.results_count' | t: count: search.results_count }}</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- else -%}
          <p class="text-muted">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search" }
{% endschema %}
