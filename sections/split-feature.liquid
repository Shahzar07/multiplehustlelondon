<section class="section section--flush-top">
  <div class="container">
    <div class="split{% if section.settings.reverse %} split--reverse{% endif %}">
      <div class="split__media" data-reveal>
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | escape }}"
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
        {%- elsif section.settings.image_asset != blank -%}
          <img src="{{ section.settings.image_asset | asset_url }}"
               alt="{{ section.settings.image_alt | escape }}"
               width="{{ section.settings.image_asset_w | default: 1200 }}" height="{{ section.settings.image_asset_h | default: 1600 }}" loading="lazy">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="split__title">{{ section.settings.heading }}</h2>
        <p class="lede">{{ section.settings.text }}</p>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-7)">
          {%- if section.settings.cta_label != blank -%}
            <a class="btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="btn btn--outline" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Fallback theme image", "default": "property-tee-trio.jpg", "info": "Filename in assets/. Used when no image is picked above." },
    { "type": "text", "id": "image_alt", "label": "Fallback image alt text", "default": "Property Of MHL tees laid out in white, grey marl and black with MHL hangtags" },
    { "type": "number", "id": "image_asset_w", "label": "Fallback image width", "default": 1402 },
    { "type": "number", "id": "image_asset_h", "label": "Fallback image height", "default": 1122 },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Brand New" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Unisex Wears" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "These are versatile, gender-neutral wears designed to be worn by individuals of any gender, promoting inclusivity and flexibility in fashion." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop This" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Shop All" },
    { "type": "url", "id": "cta2_url", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Split feature" }]
}
{% endschema %}
