<section class="section" aria-labelledby="featured-heading-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__meta">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title" id="featured-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- assign target = collections[section.settings.collection_handle] -%}
      <a class="link" href="{{ target.url | default: routes.all_products_collection_url }}">{{ 'general.view_all' | t }}</a>
    </div>

    <div class="product-grid">
      {%- if target.products.size > 0 -%}
        {%- for product in target.products limit: section.settings.count -%}
          {% render 'product-card', product: product, eager: forloop.first %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Empty state so the grid never collapses on a fresh store. {%- endcomment -%}
        <p class="text-muted">{{ 'sections.featured.empty' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Curated collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Special For You" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You Deserves More" },
    { "type": "text", "id": "collection_handle", "label": "Collection handle", "default": "you-deserves-more-1" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Curated collection" }]
}
{% endschema %}
