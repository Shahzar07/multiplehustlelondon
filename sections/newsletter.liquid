<section class="section">
  <div class="container">
    <div class="newsletter" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="newsletter__title">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.text }}</p>

      {%- form 'customer', class: 'field-inline' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="newsletter-email-{{ section.id }}">{{ 'general.newsletter.email' | t }}</label>
        <input id="newsletter-email-{{ section.id }}" type="email" name="contact[email]"
               placeholder="{{ 'general.newsletter.placeholder' | t }}" required autocomplete="email"
               value="{{ form.email }}">
        <button class="btn" type="submit">{{ 'general.newsletter.submit' | t }}</button>

        {%- if form.posted_successfully? -%}
          <p class="form-note" data-state="success">{{ 'general.newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-note" data-state="error">{{ form.errors | default_errors }}</p>
        {%- else -%}
          <p class="form-note">{{ section.settings.note }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sign up and save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be first through the door" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Subscribe to get special offers, free giveaways, and once-in-a-lifetime deals." },
    { "type": "text", "id": "note", "label": "Note", "default": "No spam. Drop announcements and early access only." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
