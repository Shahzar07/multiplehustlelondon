<section class="page-head">
  <div class="container">
    <h1 class="page-head__title">{{ 'sections.cart.title' | t }}</h1>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <p class="lede">{{ 'sections.cart.empty' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}" style="margin-top:var(--space-5)">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-page">
          <div class="cart-page__lines">
            {%- for line in cart.items -%}
              <div class="cart-line">
                <a class="cart-line__media" href="{{ line.url }}">
                  <img src="{{ line.image | image_url: width: 200 }}" alt="{{ line.title | escape }}" loading="lazy" width="100" height="133">
                </a>
                <div>
                  <p class="cart-line__title"><a href="{{ line.url }}">{{ line.product.title }}</a></p>
                  {%- unless line.variant.title contains 'Default' -%}
                    <p class="cart-line__variant">{{ line.variant.title }}</p>
                  {%- endunless -%}
                  <div class="cart-line__foot">
                    <div class="qty">
                      <button type="button" data-qty-change="{{ line.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'sections.cart.decrease' | t }}">&minus;</button>
                      <output>{{ line.quantity }}</output>
                      <button type="button" data-qty-change="{{ line.quantity | plus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'sections.cart.increase' | t }}">+</button>
                    </div>
                    <span class="product-card__price">{{ line.final_line_price | money }}</span>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <aside class="cart-page__summary">
            <dl class="cart-total">
              <dt>{{ 'sections.cart.subtotal' | t }}</dt>
              <dd>{{ cart.total_price | money }}</dd>
            </dl>
            <p class="form-note">{% render 'cart-shipping-note' %}</p>
            <button class="btn btn--full" type="submit" name="checkout" style="margin-top:var(--space-4)">{{ 'sections.cart.checkout' | t }}</button>
          </aside>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart" }
{% endschema %}
