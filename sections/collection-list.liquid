<section class="section section--flush-top" aria-labelledby="collections-heading-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__meta">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title" id="collections-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <a class="link" href="{{ routes.collections_url }}">{{ 'general.view_all' | t }}</a>
    </div>
    <div class="collection-grid">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        {%- if col != blank -%}
          <a class="collection-card" href="{{ col.url }}" data-reveal {{ block.shopify_attributes }}>
            <span class="collection-card__media">
              {%- assign card_image = block.settings.image | default: col.featured_image -%}
              {%- assign card_eager = 'lazy' -%}
              {%- if forloop.index <= 3 -%}{%- assign card_eager = 'eager' -%}{%- endif -%}
              {%- if card_image -%}
                <img src="{{ card_image | image_url: width: 900 }}" alt="" loading="{{ card_eager }}" width="900" height="1200">
              {%- elsif block.settings.image_asset != blank -%}
                <img src="{{ block.settings.image_asset | asset_url }}" alt="" loading="{{ card_eager }}"
                     width="{{ block.settings.image_asset_w | default: 900 }}" height="{{ block.settings.image_asset_h | default: 1200 }}">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </span>
            <span class="collection-card__body">
              <span class="collection-card__title">{{ block.settings.title | default: col.title }}</span>
              <span class="collection-card__cta">{{ 'general.view_collection' | t }} {% render 'icon', name: 'arrow' %}</span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" }
  ],
  "blocks": [
    {
      "type": "collection", "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Override title" },
        { "type": "image_picker", "id": "image", "label": "Override image" },
        { "type": "text", "id": "image_asset", "label": "Fallback theme image", "info": "Filename in assets/. Used when the collection has no image." },
        { "type": "number", "id": "image_asset_w", "label": "Fallback image width" },
        { "type": "number", "id": "image_asset_h", "label": "Fallback image height" }
      ]
    }
  ],
  "presets": [{ "name": "Collection list" }]
}
{% endschema %}
