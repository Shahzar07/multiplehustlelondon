<section class="section section--flush-top" aria-labelledby="collections-heading-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__meta">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title" id="collections-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <a class="link" href="{{ routes.collections_url }}">{{ 'general.view_all' | t }}</a>
    </div>
    <div class="collection-grid">
      {%- if section.blocks.size == 0 -%}
        {%- assign handles = 'men-wears|women-wears|unisex-wears|mh-ldn-hoodies|winter-wear' | split: '|' -%}
        {%- assign titles = 'Men Wears|Women Wears|Unisex Wears|MH LDN Hoodies|Summer Wears' | split: '|' -%}
        {%- assign imgs = 'mh-london-tee-model.jpg|campaign-studio.jpg|goat-tee-model.jpg|mh-london-hoodie-model.jpg|property-tee-trio.jpg' | split: '|' -%}
        {%- for handle in handles -%}
          {%- assign col = collections[handle] -%}
          <a class="collection-card" href="{{ col.url | default: '/collections/all' }}" data-reveal>
            <span class="collection-card__media">
              <img src="{{ imgs[forloop.index0] | asset_url }}" alt="" width="1122" height="1402"
                   loading="{% if forloop.index <= 3 %}eager{% else %}lazy{% endif %}">
            </span>
            <span class="collection-card__body">
              <span class="collection-card__title">{{ titles[forloop.index0] }}</span>
              <span class="collection-card__cta">View Collection {% render 'icon', name: 'arrow' %}</span>
            </span>
          </a>
        {%- endfor -%}
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection_handle] -%}
        {%- if col != blank -%}
          <a class="collection-card" href="{{ col.url }}" data-reveal {{ block.shopify_attributes }}>
            <span class="collection-card__media">
              {%- assign card_image = block.settings.image | default: col.featured_image -%}
              {%- assign card_eager = 'lazy' -%}
              {%- if forloop.index <= 3 -%}{%- assign card_eager = 'eager' -%}{%- endif -%}
              {%- if card_image -%}
                <img src="{{ card_image | image_url: width: 900 }}" alt="" loading="{{ card_eager }}" width="900" height="1200">
              {%- elsif block.settings.image_asset != blank -%}
                <img src="{{ block.settings.image_asset | asset_url }}" alt="" loading="{{ card_eager }}"
                     width="{{ block.settings.image_asset_w | default: 900 }}" height="{{ block.settings.image_asset_h | default: 1200 }}">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </span>
            <span class="collection-card__body">
              <span class="collection-card__title">{{ block.settings.title | default: col.title }}</span>
              <span class="collection-card__cta">{{ 'general.view_collection' | t }} {% render 'icon', name: 'arrow' %}</span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" }
  ],
  "blocks": [
    {
      "type": "collection", "name": "Collection",
      "settings": [
        { "type": "text", "id": "collection_handle", "label": "Collection handle" },
        { "type": "text", "id": "title", "label": "Override title" },
        { "type": "image_picker", "id": "image", "label": "Override image" },
        { "type": "text", "id": "image_asset", "label": "Fallback theme image", "info": "Filename in assets/. Used when the collection has no image." },
        { "type": "number", "id": "image_asset_w", "label": "Fallback image width" },
        { "type": "number", "id": "image_asset_h", "label": "Fallback image height" }
      ]
    }
  ],
  "presets": [{ "name": "Collection list" }],
  "default": {
    "blocks": [
      { "type": "collection", "settings": { "collection_handle": "men-wears", "title": "Men Wears", "image_asset": "mh-london-tee-model.jpg", "image_asset_w": 1122, "image_asset_h": 1402 } },
      { "type": "collection", "settings": { "collection_handle": "women-wears", "title": "Women Wears", "image_asset": "campaign-studio.jpg", "image_asset_w": 1401, "image_asset_h": 1123 } },
      { "type": "collection", "settings": { "collection_handle": "unisex-wears", "title": "Unisex Wears", "image_asset": "goat-tee-model.jpg", "image_asset_w": 1086, "image_asset_h": 1448 } },
      { "type": "collection", "settings": { "collection_handle": "mh-ldn-hoodies", "title": "MH LDN Hoodies", "image_asset": "mh-london-hoodie-model.jpg", "image_asset_w": 1122, "image_asset_h": 1402 } },
      { "type": "collection", "settings": { "collection_handle": "winter-wear", "title": "Summer Wears", "image_asset": "property-tee-trio.jpg", "image_asset_w": 1402, "image_asset_h": 1122 } }
    ]
  }
}
{% endschema %}
