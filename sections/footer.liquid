<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <p class="footer__brand-title">{{ shop.name }}</p>
        <p class="footer__tagline">{{ section.settings.tagline }}</p>
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          <a href="mailto:{{ shop.email }}" aria-label="{{ 'general.footer.email_us' | t }}">{% render 'icon', name: 'mail' %}</a>
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <ul class="footer__list">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- elsif block.type == 'contact' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <div class="footer__contact">
              <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
              {%- if block.settings.phone != blank -%}
                <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a>
              {%- endif -%}
              {%- if block.settings.location != blank -%}<span>{{ block.settings.location }}</span>{%- endif -%}
              {%- if settings.social_instagram != blank -%}
                <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">{{ settings.social_instagram_handle }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__bar">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}</p>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="payment-marks" aria-label="{{ 'general.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-mark' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea", "id": "tagline", "label": "Tagline",
      "default": "Built on ambition, discipline, and the quiet deals made behind closed doors. Started with nothing."
    }
  ],
  "blocks": [
    {
      "type": "menu", "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact", "name": "Contact column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Info" },
        { "type": "text", "id": "phone", "label": "Phone", "default": "07932 089 884" },
        { "type": "text", "id": "location", "label": "Location", "default": "London, UK" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop", "menu": "footer" } },
      { "type": "contact" }
    ]
  }
}
{% endschema %}
