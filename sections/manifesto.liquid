<section class="section section--flush-top">
  <div class="container">
    <div class="manifesto" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="manifesto__title">{{ section.settings.heading }}</h2>
      <p class="manifesto__text">{{ section.settings.text }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--gold" href="{{ section.settings.cta_url }}" style="margin-top:var(--space-7)">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Manifesto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Mindset" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "We don't just sell clothes. We sell the mindset that you deserve more." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Multiple Hustles LDN wasn't created in a boardroom; it was built on ambition, discipline, and the quiet deals made behind closed doors. We represent the individuals who don't rely on one lane to get to where they're going." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Read Our Story" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Manifesto" }]
}
{% endschema %}
