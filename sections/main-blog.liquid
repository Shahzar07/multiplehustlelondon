<section class="page-head">
  <div class="container">
    <h1 class="page-head__title">{{ blog.title }}</h1>
  </div>
</section>
<section class="section section--tight">
  <div class="container">
    <div class="collection-grid">
      {%- for article in blog.articles -%}
        <a class="collection-card" href="{{ article.url }}" data-reveal>
          {%- if article.image -%}
            <span class="collection-card__media">
              <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="900" height="1200">
            </span>
          {%- endif -%}
          <span class="collection-card__body">
            <span class="collection-card__title">{{ article.title }}</span>
            <span class="collection-card__cta">{{ article.published_at | date: '%d %B %Y' }}</span>
          </span>
        </a>
      {%- else -%}
        <p class="text-muted">{{ 'blogs.general.empty' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Blog" }
{% endschema %}
