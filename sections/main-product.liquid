{%- assign current = product.selected_or_first_available_variant -%}

<section class="section section--tight">
  <div class="container">
    <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      <span aria-hidden="true">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">{{ 'general.shop_all' | t }}</a>
      {%- endif -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product">
      <div class="product__gallery">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <figure class="product__figure">
              <img src="{{ media | image_url: width: 1400 }}"
                   srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1400 }} 1400w"
                   sizes="(min-width: 1000px) 55vw, 100vw"
                   alt="{{ media.alt | default: product.title | escape }}"
                   width="1400" height="1867"
                   {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
            </figure>
          {%- endfor -%}
        {%- else -%}
          <figure class="product__figure">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</figure>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- if product.vendor != blank -%}<p class="eyebrow">{{ product.vendor }}</p>{%- endif -%}
        <h1 class="product__title">{{ product.title }}</h1>

        <div class="product__price">
          {%- if product.compare_at_price > product.price -%}
            <del data-compare-price>{{ product.compare_at_price | money }}</del>
          {%- endif -%}
          <span data-price>{{ current.price | money }}</span>
        </div>

        {%- if product.description != blank -%}
          <div class="product__desc rte">{{ product.description }}</div>
        {%- endif -%}

        <form method="post" action="{{ routes.cart_add_url }}" data-product-form>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign opt_index = forloop.index -%}
              {%- assign name_down = option.name | downcase -%}
              <div class="option-group">
                <p class="option-group__label">
                  <span>{{ option.name }}</span>
                  <span class="option-group__value" data-option-label="{{ opt_index }}">{{ option.selected_value }}</span>
                </p>
                <div class="option-list" role="group" aria-label="{{ option.name | escape }}">
                  {%- for value in option.values -%}
                    {%- assign is_selected = false -%}
                    {%- if option.selected_value == value -%}{%- assign is_selected = true -%}{%- endif -%}
                    {%- if name_down == 'colour' or name_down == 'color' -%}
                      <button class="option-btn option-swatch" type="button"
                              style="--swatch:{{ value | downcase | replace: ' ', '' }}"
                              data-option-index="{{ opt_index }}" data-option-value="{{ value | escape }}"
                              aria-pressed="{{ is_selected }}">
                        <span class="visually-hidden">{{ value }}</span>
                      </button>
                    {%- else -%}
                      <button class="option-btn" type="button"
                              data-option-index="{{ opt_index }}" data-option-value="{{ value | escape }}"
                              aria-pressed="{{ is_selected }}">{{ value }}</button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <div class="product__actions">
            <button class="btn btn--full" type="submit" data-add-to-cart
                    data-label-add="{{ 'products.product.add_to_bag' | t }}"
                    data-label-sold-out="{{ 'products.product.sold_out' | t }}"
                    {% unless current.available %}disabled{% endunless %}>
              {%- if current.available -%}
                {{ 'products.product.add_to_bag' | t }} &mdash; <span data-button-price>{{ current.price | money }}</span>
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
            <a class="btn btn--outline btn--full" href="{{ routes.all_products_collection_url }}">
              {{ 'general.continue_shopping' | t }}
            </a>
          </div>
        </form>

        {%- if section.blocks.size > 0 -%}
          <div class="accordion">
            {%- for block in section.blocks -%}
              {%- if block.type == 'details' -%}
                <div class="accordion__item" {{ block.shopify_attributes }}>
                  <button class="accordion__trigger" type="button" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
                    {{ block.settings.heading }}<span class="accordion__icon" aria-hidden="true"></span>
                  </button>
                  <div class="accordion__panel">
                    <div class="rte">{{ block.settings.content }}</div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} Variant map for the option pickers — read by theme.js. {%- endcomment -%}
<script type="application/json" data-variant-data>
[
  {%- for variant in product.variants -%}
    {
      "id": {{ variant.id }},
      "options": {{ variant.options | json }},
      "available": {{ variant.available }},
      "price_formatted": {{ variant.price | money | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>

{% schema %}
{
  "name": "Product",
  "blocks": [
    {
      "type": "details", "name": "Accordion panel",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "details", "settings": { "heading": "Shipping & Returns" } },
      { "type": "details", "settings": { "heading": "Care" } }
    ]
  }
}
{% endschema %}
