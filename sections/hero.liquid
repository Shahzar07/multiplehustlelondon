<section class="hero" data-hero aria-label="{{ section.settings.aria_label }}">
  {%- if section.blocks.size == 0 -%}
    {%- assign eyebrows = 'New Arrival|Shop Today' | split: '|' -%}
    {%- assign headings = 'Started With Nothing|Multiple Hustles London' | split: '|' -%}
    {%- assign texts = 'Built on ambition, discipline, and the quiet deals made behind closed doors. The uniform for everyone who doesn’t rely on one lane.|The stacked lockup in silver and sky blue, printed large on heavyweight black cotton. Limited drop — once it’s gone, it’s gone.' | split: '|' -%}
    {%- assign images = 'goat-tee-model.jpg|mh-london-tee-model.jpg' | split: '|' -%}
    {%- assign alts = 'Model on a Peckham corner wearing the black Greatest Of All Time tee with denim shorts|Model outside Peckham Park Estate wearing the Multiple Hustles London tee' | split: '|' -%}
    {%- assign ctas = 'Shop Now|Shop The Tee' | split: '|' -%}
    {%- assign heights = '1448|1402' | split: '|' -%}
    {%- assign widths = '1086|1122' | split: '|' -%}
    {%- for image in images -%}
      <div class="hero__slide{% if forloop.first %} is-active{% endif %}">
        <div class="hero__media">
          <img style="--focal:50% 30%" src="{{ image | asset_url }}" alt="{{ alts[forloop.index0] }}"
               width="{{ widths[forloop.index0] }}" height="{{ heights[forloop.index0] }}"
               {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        </div>
        <div class="container">
          <div class="hero__content">
            <p class="eyebrow hero__eyebrow">{{ eyebrows[forloop.index0] }}</p>
            {%- if forloop.first -%}
              <h1 class="hero__title">{{ headings[forloop.index0] }}</h1>
            {%- else -%}
              <h2 class="hero__title">{{ headings[forloop.index0] }}</h2>
            {%- endif -%}
            <p class="hero__text">{{ texts[forloop.index0] }}</p>
            <div class="hero__cta">
              <a class="btn btn--light" href="{{ routes.all_products_collection_url }}">{{ ctas[forloop.index0] }}</a>
              {%- if forloop.first -%}
                <a class="btn btn--outline" href="/pages/about" style="--btn-fg:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.5)">Our Story</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
    <div class="hero__dots" role="tablist" aria-label="Choose slide">
      <button class="hero__dot is-active" type="button" role="tab" aria-label="Slide 1"></button>
      <button class="hero__dot" type="button" role="tab" aria-label="Slide 2"></button>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    <div class="hero__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
      <div class="hero__media">
        {%- if block.settings.image -%}
          <img style="--focal:{{ block.settings.focal_x }}% {{ block.settings.focal_y }}%"
               src="{{ block.settings.image | image_url: width: 1600 }}"
               srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1600 }} 1600w"
               sizes="100vw"
               alt="{{ block.settings.image.alt | escape }}"
               width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
               {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {%- elsif block.settings.image_asset != blank -%}
          {%- comment -%} Bundled theme photography, so the page looks right before
          a merchant picks anything in the customizer. {%- endcomment -%}
          <img style="--focal:{{ block.settings.focal_x }}% {{ block.settings.focal_y }}%"
               src="{{ block.settings.image_asset | asset_url }}"
               alt="{{ block.settings.image_alt | escape }}"
               width="{{ block.settings.image_asset_w | default: 1200 }}" height="{{ block.settings.image_asset_h | default: 1600 }}"
               {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div class="container">
        <div class="hero__content">
          {%- if block.settings.eyebrow != blank -%}
            <p class="eyebrow hero__eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if forloop.first -%}
            <h1 class="hero__title">{{ block.settings.heading }}</h1>
          {%- else -%}
            <h2 class="hero__title">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="hero__text">{{ block.settings.text }}</p>
          {%- endif -%}
          <div class="hero__cta">
            {%- if block.settings.cta_label != blank -%}
              <a class="btn btn--light" href="{{ block.settings.cta_url | default: routes.all_products_collection_url }}">{{ block.settings.cta_label }}</a>
            {%- endif -%}
            {%- if block.settings.cta2_label != blank -%}
              <a class="btn btn--outline" href="{{ block.settings.cta2_url }}" style="--btn-fg:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.5)">{{ block.settings.cta2_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots" role="tablist" aria-label="{{ 'sections.hero.choose_slide' | t }}">
      {%- for block in section.blocks -%}
        <button class="hero__dot{% if forloop.first %} is-active{% endif %}" type="button" role="tab"
                aria-label="{{ 'sections.hero.slide' | t: number: forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Featured collections" }
  ],
  "blocks": [
    {
      "type": "slide", "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Fallback theme image", "info": "Filename in assets/. Used when no image is picked above." },
        { "type": "text", "id": "image_alt", "label": "Fallback image alt text" },
        { "type": "number", "id": "image_asset_w", "label": "Fallback image width" },
        { "type": "number", "id": "image_asset_h", "label": "Fallback image height" },
        { "type": "range", "id": "focal_x", "label": "Focal point X", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "type": "range", "id": "focal_y", "label": "Focal point Y", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Arrival" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Started With Nothing" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Now" },
        { "type": "url", "id": "cta_url", "label": "Button link" },
        { "type": "text", "id": "cta2_label", "label": "Secondary button label" },
        { "type": "url", "id": "cta2_url", "label": "Secondary button link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "slide", "settings": {
        "eyebrow": "New Arrival", "heading": "Started With Nothing",
        "text": "Built on ambition, discipline, and the quiet deals made behind closed doors. The uniform for everyone who doesn't rely on one lane.",
        "cta_label": "Shop Now", "cta2_label": "Our Story",
        "focal_x": 50, "focal_y": 30,
        "image_asset": "goat-tee-model.jpg", "image_asset_w": 1086, "image_asset_h": 1448,
        "image_alt": "Model on a Peckham corner wearing the black Greatest Of All Time tee with denim shorts" } },
      { "type": "slide", "settings": {
        "eyebrow": "Shop Today", "heading": "Multiple Hustles London",
        "text": "The stacked lockup in silver and sky blue, printed large on heavyweight black cotton. Limited drop — once it's gone, it's gone.",
        "cta_label": "Shop The Tee",
        "focal_x": 50, "focal_y": 30,
        "image_asset": "mh-london-tee-model.jpg", "image_asset_w": 1122, "image_asset_h": 1402,
        "image_alt": "Model outside Peckham Park Estate wearing the Multiple Hustles London tee" } }
    ]
  }
}
{% endschema %}
