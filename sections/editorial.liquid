<section class="section section--flush-top">
  <div class="container">
    <article class="editorial" data-reveal>
      <div class="editorial__media">
        {%- if section.settings.image -%}
          <img style="--focal:{{ section.settings.focal_x }}% {{ section.settings.focal_y }}%"
               src="{{ section.settings.image | image_url: width: 1600 }}"
               alt="{{ section.settings.image.alt | escape }}"
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div class="container">
        <div class="editorial__body">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow" style="color:rgba(255,255,255,.72)">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="editorial__title">{{ section.settings.heading }}</h2>
          <p class="editorial__text">{{ section.settings.text }}</p>
          {%- if section.settings.cta_label != blank -%}
            <a class="btn btn--light" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Editorial banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "focal_x", "label": "Focal point X", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "Focal point Y", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 18 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Brand Vision" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build in the Shadows. Win in Plain Sight." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "True success doesn't need to shout. It shows up in the details — the quality of the fabric, the cut of the silhouette, and the confidence of the person wearing it." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Hoodies" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Editorial banner" }]
}
{% endschema %}
