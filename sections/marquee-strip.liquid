{%- assign fallback = 'Started With Nothing,Dreamers Only,Born in London,Limited Drops' | split: ',' -%}
<div class="strip" aria-hidden="true">
  <div class="strip__track">
    {%- for group in (1..2) -%}
      <div class="strip__group">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <span class="strip__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endfor -%}
        {%- else -%}
          {%- for item in fallback -%}<span class="strip__item">{{ item }}</span>{%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee strip",
  "max_blocks": 6,
  "blocks": [
    { "type": "item", "name": "Phrase", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Started With Nothing" } ] }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "text": "Started With Nothing" } },
      { "type": "item", "settings": { "text": "Dreamers Only" } },
      { "type": "item", "settings": { "text": "Born in London" } },
      { "type": "item", "settings": { "text": "Limited Drops" } }
    ]
  }
}
{% endschema %}
